# 복사해서 .env로 쓴다: cp .env.example .env
# .env는 저장소에 올라가지 않는다. 비워 둔 값은 "설정 안 함"이다.
# 우선순위: 명령줄 옵션 > env 파일 > config.py 기본값

# 슬랙 Incoming Webhook 주소. --send로 실제 발송할 때만 필요. 없으면 드라이런만 된다.
SLACK_WEBHOOK_URL=
# Anthropic API 키. 있으면 진짜 AI 요약, 없으면 가짜 AI 요약.
ANTHROPIC_API_KEY=
# AI 요약에 쓸 모델 이름. 비우면 config.py의 기본값을 쓴다.
LLM_MODEL=claude-sonnet-5
# 입력 CSV 3개(sku_master.csv, inventory_snapshot.csv, sales_daily.csv)가 있는 폴더.
DATA_DIR=data
# 실행 결과(슬랙 글 미리보기 slack_message_날짜.txt, 판정 report_날짜.json)를 저장하는 폴더.
OUTPUT_DIR=output
# "오늘 이미 보냈다" 기록(sent_log.json)을 저장하는 폴더. 같은 날 중복 발송을 막는 데 쓴다.
STATE_DIR=state
# 로그 상세 정도. DEBUG, INFO, WARNING, ERROR 중 하나.
LOG_LEVEL=INFO
